# 复制为 .env 后填写，或用网页向导填写。不要把真实 .env 提交到 Git。
# DeepSeek 开放平台 API Key，用户自己出 API 费用
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 主人 QQ 号：只有这个号能私聊机器人，其他人一律忽略
OWNER_QQ=

# NapCat 的 HTTP 调用地址（NapCat 默认 3000；Docker 部署时见 docker-compose.yml 注释）
ONEBOT_HTTP_URL=http://127.0.0.1:3000
# 本框架 HTTP 监听端口：把 NapCat 的上报地址指向 http://127.0.0.1:8080
PORT=8080

# 人设：lover / wife / confidant，见 src/personas.json；自定义见 personas/custom.example.json
PERSONA=lover
# 表情包模式：emoji（默认）/ face（QQ 表情 CQ 码）/ custom（stickers/custom/ 图片）/ off
STICKER_MODE=emoji
# 每日调用上限（按次计，防 API 账单失控）
DAILY_LIMIT=100
# 表情概率 0–1：真人不会每条都挂表情，默认 1/4
STICKER_RATE=0.25
# 回复前延迟基数（毫秒）：0 表示秒回，默认 1.5 秒起
REPLY_DELAY_MS=1500
